{
  "name": "uiotg",
  "version": "0.1.0",
  "description": "User Interface On The Go: an MCP server that renders data into UI images from a library of templates",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uiotg": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "charts",
    "data-visualization",
    "image",
    "ui",
    "screenshot"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node src/cli.ts serve",
    "gallery": "node src/cli.ts gallery --out gallery",
    "audit": "node scripts/audit.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lucide-static": "^1.54.0",
    "marked": "^18.1.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  }
}
