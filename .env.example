# Generate with: openssl rand -hex 32
UIOTG_AUTH_TOKEN=
# e.g. https://uiotg.example.com (leave empty to skip image URLs)
UIOTG_PUBLIC_URL=
# Port on this machine that maps to uiotg (container side stays 8080)
UIOTG_PORT=3948
UIOTG_THEME=light
# Maps: OpenStreetMap tiles by default (light use). For production, a keyed provider:
# UIOTG_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}{r}.png?key=YOUR_KEY
# UIOTG_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# UIOTG_TILE_CONTACT=you@example.com
# Photo backgrounds for weather, world clock, sports and occasion cards (optional, free keys).
# Without one, these templates use generated art.
# UIOTG_UNSPLASH_ACCESS_KEY=   # https://unsplash.com/developers
# UIOTG_PEXELS_API_KEY=        # https://www.pexels.com/api/
